# Salesforce Sales Cloud QA Configuration
# Copy this file to .env and fill in your Salesforce credentials.
# Never commit .env with real credentials.

# Salesforce environment
SF_BASE_URL=https://login.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com
SF_DOMAIN=your-domain.my.salesforce.com

# Salesforce credentials (DO NOT COMMIT REAL VALUES)
SF_USERNAME=your-email@example.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=your-security-token

# Browser settings
BROWSER=chromium
HEADLESS=false

# CI settings
CI=false