{
  "name": "salesforce-sales-cloud-qa",
  "version": "1.0.0",
  "description": "Salesforce Sales Cloud QA Automation Framework - Lead-to-Opportunity business process testing with Playwright and TypeScript",
  "private": true,
  "author": "yazanus94-dot",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "setup": "bash scripts/setup.sh",
    "run:tests": "bash scripts/run_tests.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "eslint": "^8.56.0",
    "eslint-plugin-playwright": "^1.6.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}